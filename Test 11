--========================================================

local function MakeToggle(parent, text, default, callback)
    local Holder = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 48),

        BackgroundColor3 = C.Card,
        BackgroundTransparency = 0.04,

        BorderSizePixel = 0
    }, parent)

    Round(Holder, 10)

    Outline(Holder, C.Cyan, 1, 0.72)

    local LabelObject = Create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),

        BackgroundTransparency = 1,

        Text = text,
        TextColor3 = C.White,
        TextSize = 12,
        Font = Enum.Font.GothamBold,

        TextXAlignment = Enum.TextXAlignment.Left
    }, Holder)

    local Toggle = Create("TextButton", {
        Size = UDim2.fromOffset(42, 22),
        Position = UDim2.new(1, -53, 0.5, -11),

        BackgroundColor3 = default and C.Blue or C.Background,

        Text = "",
        BorderSizePixel = 0,
        AutoButtonColor = false
    }, Holder)

    Round(Toggle, 12)
    Outline(Toggle, C.Cyan, 1, 0.45)

    local Knob = Create("Frame", {
        Size = UDim2.fromOffset(16, 16),

        Position = default
            and UDim2.new(1, -19, 0.5, -8)
            or UDim2.fromOffset(3, 3),

        BackgroundColor3 = C.White,
        BorderSizePixel = 0
    }, Toggle)

    Round(Knob, 20)

    local Enabled = default

    Toggle.MouseButton1Click:Connect(function()
        Enabled = not Enabled

        Animate(Toggle, {
            BackgroundColor3 = Enabled and C.Blue or C.Background
        })

        Animate(Knob, {
            Position = Enabled
                and UDim2.new(1, -19, 0.5, -8)
                or UDim2.fromOffset(3, 3)
        })

        if callback then
            callback(Enabled)
        end
