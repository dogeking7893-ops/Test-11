local PingPoints = {}
local FPSPoints = {}

local MAX_GRAPH_POINTS = 30

local function ReflowGraph(Graph, Points)

    local Count = #Points

    if Count == 0 then
        return
    end

    local Width = Graph.AbsoluteSize.X

    if Width <= 0 then
        return
    end

    local Step

    if Count == 1 then
        Step = 0
    else
        Step = Width / (Count - 1)
    end

    for Index, Point in ipairs(Points) do

        local X = (Index - 1) * Step

        Point.Position =
            UDim2.new(
                0,
                X - 2,
                Point.Position.Y.Scale,
                -2
            )
    end
end

local function AddGraphPoint(
    Graph,
    Points,
    Value,
    Maximum
)

    if not Graph or not Graph.Parent then
        return
    end

    Maximum =
        math.max(
            tonumber(Maximum) or 1,
            1
        )

    Value =
        math.max(
            tonumber(Value) or 0,
            0
        )

    local Alpha =
        math.clamp(
            Value / Maximum,
            0,
            1
        )

    local Point = Create("Frame", {
        Size = UDim2.fromOffset(4, 4),
        BackgroundColor3 = C.Cyan,
        BorderSizePixel = 0,
        Parent = Graph
    })

    Round(Point, 4)

    Point.Position =
        UDim2.new(
            1,
            -2,
            1 - Alpha,
            -2
        )

    table.insert(Points, Point)

    while #Points > MAX_GRAPH_POINTS do

        local Old =
            table.remove(Points, 1)

        if Old then
            Old:Destroy()
        end
    end

    ReflowGraph(Graph, Points)
end

