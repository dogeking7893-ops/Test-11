--==================================================
-- AVATAR PREVIEW
--==================================================

local AvatarModel = nil
local AvatarAngle = 0
local AvatarDragging = false
local AvatarDragStart = nil
local AvatarBuildId = 0

local function CleanAvatarModel(Model)

    if not Model then
        return
    end

    for _, Item in ipairs(Model:GetDescendants()) do

        if Item:IsA("Script")
        or Item:IsA("LocalScript")
        or Item:IsA("ModuleScript") then

            Item:Destroy()

        elseif Item:IsA("Tool") then

            Item:Destroy()

        elseif Item:IsA("BasePart") then

            Item.Anchored = true
            Item.CanCollide = false
            Item.CanTouch = false
            Item.CanQuery = false
            Item.LocalTransparencyModifier = 0

            if Item.Name == "HumanoidRootPart" then
                Item.Transparency = 1
            end
        end
    end

    Model.Parent = AvatarWorld

    local Root = Model:FindFirstChild("HumanoidRootPart")

    if Root and Root:IsA("BasePart") then
        Model.PrimaryPart = Root
    end
end

local function PositionAvatar()

    if not AvatarModel then
        return
    end

    local BoundingCFrame, BoxSize =
        AvatarModel:GetBoundingBox()

    local Height = math.max(BoxSize.Y, 2)

    AvatarModel:PivotTo(
        CFrame.new(0, 0, 0)
        * CFrame.Angles(0, AvatarAngle, 0)
    )

    AvatarCamera.FieldOfView = 42

    local UpdatedCFrame, UpdatedSize =
        AvatarModel:GetBoundingBox()

    local CenterY = UpdatedCFrame.Position.Y
    local ActualHeight = math.max(
        UpdatedSize.Y,
        Height
    )

    local HalfHeight = ActualHeight * 0.5

    local FOVRadians =
        math.rad(AvatarCamera.FieldOfView)

    local CameraDistance =
        HalfHeight /
        math.tan(FOVRadians * 0.5)

    CameraDistance *= 1.18
    CameraDistance = math.max(CameraDistance, 5)

    AvatarCamera.CFrame = CFrame.lookAt(
        Vector3.new(
            0,
            CenterY,
            -CameraDistance
        ),
        Vector3.new(
            0,
            CenterY,
            0
        )
    )
end

--==================================================
-- BUILD AVATAR
--==================================================

local function BuildAvatarPreview()

    AvatarBuildId += 1

    local ThisBuild = AvatarBuildId

    if AvatarModel then
        AvatarModel:Destroy()
        AvatarModel = nil
    end

    task.spawn(function()

        local Character = Player.Character

        if not Character then
            Character = Player.CharacterAdded:Wait()
        end

        if not Character then
            return
        end

        if ThisBuild ~= AvatarBuildId then
            return
        end

        local PreviousArchivable =
            Character.Archivable

        Character.Archivable = true

        local Model = Character:Clone()

        Character.Archivable = PreviousArchivable

        if not Model then
            StateLabel.Text = "STATE: PREVIEW FAILED"
            return
        end

        if ThisBuild ~= AvatarBuildId then
            Model:Destroy()
            return
        end

        if not Model:IsA("Model") then
            Model:Destroy()
            StateLabel.Text = "STATE: INVALID PREVIEW"
            return
        end

        CleanAvatarModel(Model)

        if ThisBuild ~= AvatarBuildId then
            Model:Destroy()
            return
        end

        local HasRenderablePart = false

        for _, Item in ipairs(Model:GetDescendants()) do

            if Item:IsA("BasePart")
            and Item.Name ~= "HumanoidRootPart" then

                HasRenderablePart = true
                break
            end
        end

        if not HasRenderablePart then
            Model:Destroy()
            StateLabel.Text = "STATE: NO BODY PARTS"
            return
        end

        AvatarModel = Model
        AvatarAngle = 0

        PositionAvatar()

        StateLabel.Text = "STATE: ONLINE"

    end)
end

BuildAvatarPreview()

Player.CharacterAdded:Connect(function()

    task.wait(1)

    BuildAvatarPreview()

end)

--==================================================
-- AVATAR ROTATION
--==================================================

AvatarViewport.InputBegan:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        if AvatarModel then
            AvatarDragging = true
            AvatarDragStart = Input.Position
        end
    end
end)

UIS.InputChanged:Connect(function(Input)

    if not AvatarDragging then
        return
    end

    if not AvatarModel then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseMovement
    or Input.UserInputType == Enum.UserInputType.Touch then

        local Delta =
            Input.Position - AvatarDragStart

        AvatarDragStart = Input.Position

        AvatarAngle += Delta.X * 0.012

        AvatarModel:PivotTo(
            CFrame.new(0, 0, 0)
            * CFrame.Angles(0, AvatarAngle, 0)
        )
    end
end)

UIS.InputEnded:Connect(function(Input)

    if Input.UserInputType == Enum.UserInputType.MouseButton1
    or Input.UserInputType == Enum.UserInputType.Touch then

        AvatarDragging = false
    end
end)

