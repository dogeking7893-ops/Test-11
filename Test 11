--==================================================
-- PAGE SELECTION
--==================================================

local function SelectPage(name)

    if not Pages[name] then
        return
    end

    CurrentPage = name

    for PageName, Page in pairs(Pages) do
        Page.Visible = PageName == name

        if Page.Visible then
            Page.CanvasPosition = Vector2.new(0, 0)
        end
    end

    for TabName, Tab in pairs(Tabs) do

        local Selected = TabName == name

        Animate(Tab, {
            BackgroundColor3 = Selected
                and C.Selected
                or C.Sidebar
        }, 0.15)

        local Stroke = Tab:FindFirstChildOfClass("UIStroke")

        if Stroke then
            Animate(Stroke, {
                Transparency = Selected and 0.08 or 0.65
            }, 0.15)
        end

        local Indicator = Tab:FindFirstChild("ActiveIndicator")

        if Indicator then
            Indicator.Visible = Selected
        end

        local IconPlate = Tab:FindFirstChild("IconPlate")

        if IconPlate then
            Animate(IconPlate, {
                BackgroundColor3 = Selected
                    and C.Blue
                    or C.Content
            }, 0.15)
        end
    end
end

