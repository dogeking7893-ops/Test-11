local RunService =
    game:GetService("RunService")

local FPSFrames = 0
local FPSTime = 0


RunService.RenderStepped:Connect(
    function(DeltaTime)

        FPSFrames += 1
        FPSTime += DeltaTime


        if FPSTime >= 0.5 then

            local FPS =
                math.floor(
                    math.clamp(
                        FPSFrames / FPSTime,
                        0,
                        240
                    ) + 0.5
                )


            CurrentFPS = FPS

            FPSFrames = 0
            FPSTime = 0


            --================================================--
            -- FPS DISPLAY
            --================================================--

            if FPSLabel then

                FPSLabel.Text =
                    "FPS: "
                    .. tostring(FPS)


                if FPS <= 10 then

                    FPSLabel.TextColor3 =
                        C.Red

                elseif FPS <= 30 then

                    FPSLabel.TextColor3 =
                        C.Violet

                else

                    FPSLabel.TextColor3 =
                        C.White

                end

            end


            --================================================--
            -- FPS GRAPH
            --================================================--

            if FPSGraph then

                AddGraphPoint(
                    FPSGraph,
                    FPSPoints,
                    FPS,
                    120
                )

            end


            --================================================--
            -- LOW FPS ALERT
            --================================================--

            if FPS <= 10 then

                if not FPSAlertActive then

                    FPSAlertActive = true


                    task.spawn(
                        function()

                            ShowNotification(

                                "LOW FPS",

                                string.format(
                                    "Performance dropped to %.0f FPS",
                                    FPS
                                ),

                                C.Violet,

                                string.format(
                                    "%02d FPS",
                                    FPS
                                )

                            )

                        end
                    )

                end

            else

                -- Re-arm once FPS recovers
                FPSAlertActive = false

            end

        end

    end
)


