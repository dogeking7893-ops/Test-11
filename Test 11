local function FormatSessionTime(Seconds)

    Seconds = math.max(
        math.floor(Seconds),
        0
    )

    local Hours =
        math.floor(Seconds / 3600)

    local Minutes =
        math.floor(
            (Seconds % 3600) / 60
        )

    local Remaining =
        Seconds % 60

    return string.format(
        "%02d:%02d:%02d",
        Hours,
        Minutes,
        Remaining
    )
end

